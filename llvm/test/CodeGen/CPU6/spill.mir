# RUN: llc -mtriple=cpu6 -run-pass=regallocfast,prolog-epilog -verify-machineinstrs -o - %s | FileCheck %s

# The fast allocator spills a value that is live out of its block. %0 sits in
# Z, which is not A, so the spill is STR and the reload is XFR. Z is also
# callee-saved: STK saves the incoming Z above the spill slot.

# CHECK-LABEL: name: across
# CHECK:      frame-setup STK $rz, 1
# CHECK-NEXT: $rs = frame-setup ADDimm $rs, -2
# CHECK-NEXT: STRidx killed $rz, $rs, 0, implicit-def $rm, implicit-def $rv :: (store (s16) into %stack.0, align 1)
# CHECK:      bb.1:
# CHECK:      $rz = XFRidx $rs, 0, implicit-def $rm, implicit-def $rv :: (load (s16) from %stack.0, align 1)
# CHECK:      $rs = frame-destroy ADDimm $rs, 2
# CHECK-NEXT: $rz = frame-destroy POP 1

# A spill slot above a 300-byte local is 300 bytes from S. LDAfi and STAfi
# only have a displacement byte; STR and XFR take a word.

# CHECK-LABEL: name: wide
# CHECK:      $rs = frame-setup ADDimm $rs, -302
# CHECK-NEXT: STRidx killed $rb, $rs, 300
# CHECK-NEXT: $ra = XFRidx $rs, 300
# CHECK-NEXT: $rs = frame-destroy ADDimm $rs, 302

--- |
  define i16 @across(i16 %z) { ret i16 %z }
  define i16 @wide(i16 %b) { ret i16 %b }
...
---
name: across
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $rz
    %0:gpr = COPY $rz

  bb.1:
    $rz = COPY %0
    $ra = XFRimm 0, implicit-def $rm, implicit-def $rv
    RSR implicit killed $ra, implicit killed $rz
...
---
name: wide
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 1 }
  - { id: 1, size: 300, alignment: 1 }
body: |
  bb.0:
    liveins: $rb
    STRidx killed $rb, $rs, %stack.0, implicit-def $rm, implicit-def $rv
    $ra = XFRidx $rs, %stack.0, implicit-def $rm, implicit-def $rv
    RSR implicit killed $ra
...
