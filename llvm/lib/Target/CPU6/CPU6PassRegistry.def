//
// Included from CPU6TargetMachine::registerPassBuilderCallbacks. No include
// guard: the includer defines the macros around each include.

#ifndef MACHINE_FUNCTION_PASS
#define MACHINE_FUNCTION_PASS(NAME, CREATE_PASS)
#endif
MACHINE_FUNCTION_PASS("cpu6-isel", CPU6ISelDAGToDAGPass(*this, getOptLevel()))
#undef MACHINE_FUNCTION_PASS
